<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexKit;assembly=CodexInitKit">
  <DrawingImage x:Key="ParentModelMark"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#334761"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32" RadiusX="10" RadiusY="10"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#AFCFF2" Geometry="M10,11 L9,6.6 Q8.7,5 10.4,5.8 L13.6,7.4 L15.1,4.1 Q16,2.5 16.9,4.1 L18.4,7.4 L21.6,5.8 Q23.3,5 23,6.6 L22,11 Z"/>
    <GeometryDrawing Brush="#C8DDF7"><GeometryDrawing.Geometry><RectangleGeometry Rect="4,10,24,17" RadiusX="7.5" RadiusY="7.5"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#405774"><GeometryDrawing.Geometry><RectangleGeometry Rect="7,13.5,18,10" RadiusX="5" RadiusY="5"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#E6F2FF"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="11.5,18" RadiusX="1.35" RadiusY="1.7"/><EllipseGeometry Center="20.5,18" RadiusX="1.35" RadiusY="1.7"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Geometry="M14.6,19.2 Q16,21 17.4,19.2"><GeometryDrawing.Pen><Pen Brush="#E6F2FF" Thickness="1.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="ChildModelMark"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#294942"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32" RadiusX="10" RadiusY="10"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#A3DCC5" Geometry="M16,13 C14.7,6.6 19.2,3.8 24.3,4.7 C24.1,9.8 21,12 17.2,11.6 L17.2,13 Z"/>
    <GeometryDrawing Brush="#81B9A7" Geometry="M16,13 C11.8,12.7 9.2,10.1 9.1,7.4 C13.1,6.7 16.4,8.4 16.7,11.9 Z"/>
    <GeometryDrawing Brush="#B5E3D1"><GeometryDrawing.Geometry><RectangleGeometry Rect="5.5,12,21,15" RadiusX="7" RadiusY="7"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#355C54"><GeometryDrawing.Geometry><RectangleGeometry Rect="8.3,15.1,15.4,8.6" RadiusX="4.3" RadiusY="4.3"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#E0F8ED"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="12.2,19" RadiusX="1.25" RadiusY="1.45"/><EllipseGeometry Center="19.8,19" RadiusX="1.25" RadiusY="1.45"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Geometry="M14.9,20.2 Q16,21.7 17.1,20.2"><GeometryDrawing.Pen><Pen Brush="#E0F8ED" Thickness="1.1" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <ControlTemplate x:Key="KitDialogWindow" TargetType="Window">
    <Grid x:Name="DialogCard" Margin="{TemplateBinding Padding}">
      <Border IsHitTestVisible="False" Margin="1" CornerRadius="11" Background="{Binding Content.Background, RelativeSource={RelativeSource TemplatedParent}}">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.56"/>
        </Border.Effect>
      </Border>
      <AdornerDecorator>
        <ContentPresenter/>
      </AdornerDecorator>
    </Grid>
  </ControlTemplate>
  <Style x:Key="KitFeatureHint" TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Placement" Value="Bottom"/>
    <Setter Property="VerticalOffset" Value="2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="8,0,10,12">
            <Border Background="#283747" BorderBrush="#506378" BorderThickness="1" CornerRadius="10">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.45"/>
              </Border.Effect>
            </Border>
            <ContentPresenter Margin="12,9"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="KitScrollThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#3B4B5D" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#AFBED0"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9DAFC4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}" CornerRadius="6"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource KitScrollPage}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb x:Name="ScrollThumb" Style="{StaticResource KitScrollThumb}" MinHeight="24" MinWidth="8"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource KitScrollPage}"/></Track.IncreaseRepeatButton>
      </Track></Border>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="8"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="24"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="KitInput" TargetType="TextBox">
    <Setter Property="Background" Value="#1C2937"/><Setter Property="Foreground" Value="#ECEEF0"/>
    <Setter Property="BorderBrush" Value="#3B4B5D"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="#ECEEF0"/><Setter Property="SelectionBrush" Value="#AFBED0"/><Setter Property="SelectionOpacity" Value="0.6"/>
    <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#9DAFC4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="KitCheck" TargetType="CheckBox">
    <Setter Property="Foreground" Value="#ECEEF0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,6,0,6"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Box" Width="20" Height="20" CornerRadius="7" Background="#1C2937" BorderBrush="#AFBED0" BorderThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Path x:Name="Tick" Data="M3.4,8.4 L6.7,11.4 Q7.6,12.2 8.4,11.2 L13.6,5.1" Stroke="#172535" StrokeThickness="2.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
        </Border>
        <DockPanel Grid.Column="1" VerticalAlignment="Center">
          <Path x:Name="CheckIcon" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" Margin="0,0,6,0" IsHitTestVisible="False"/>
          <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="CheckIcon" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#9DAFC4"/><Setter TargetName="Box" Property="BorderBrush" Value="#9DAFC4"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#AFBED0"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#AFBED0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitButtonShadow" TargetType="Border">
    <Setter Property="Effect" Value="{Binding Path=(local:Motion.ButtonShadow), RelativeSource={RelativeSource TemplatedParent}}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background" Value="#1E2B3B"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Margin" Value="1"/>
  </Style>
  <Style x:Key="KitCliChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#ECEEF0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Padding" Value="16,10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid>
        <Border x:Name="ShadowLayer" Style="{StaticResource KitButtonShadow}"/>
        <Border x:Name="Choice" Background="#2B3A4C" BorderBrush="#AFBED0" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#9DAFC4"/><Setter TargetName="Choice" Property="BorderBrush" Value="#9DAFC4"/><Setter Property="Foreground" Value="#172535"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#AFBED0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#ECEEF0"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B3A4C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#3B5066"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitCombo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="#ECEEF0"/><Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="#1C2937"/><Setter Property="BorderBrush" Value="#3B4B5D"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource KitComboItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="#1C2937" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="8"><Path Data="M1.5,1.5 L5.4,5.1 Q6.5,6.1 7.6,5.1 L11.5,1.5" Stroke="#9DAFC4" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DAFC4"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DAFC4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
          <Border Background="#253343" BorderBrush="#3B4B5D" BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><local:SmoothScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></local:SmoothScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#AFBED0"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="KitButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#3B4B5D"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="ShadowLayer" Style="{StaticResource KitButtonShadow}"/>
        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><DockPanel><Path x:Name="ButtonIcon" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel></Border>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#AFBED0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitFooterLink" TargetType="Button">
    <Setter Property="Foreground" Value="#ADBDCE"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4,4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
        <ContentPresenter VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2B3A4C"/><Setter Property="Foreground" Value="#EDF2FC"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DAFC4"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35485D"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitProgress" TargetType="ProgressBar">
    <Setter Property="Foreground"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#9DAFC4" Offset="0"/><GradientStop Color="#AFBED0" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True">
      <Border x:Name="PART_Track" Background="#2B3A4C" CornerRadius="4"/>
      <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
      <Border x:Name="Activity" CornerRadius="4" Visibility="Collapsed">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ActivityOffset"/></LinearGradientBrush.RelativeTransform>
            <GradientStop Offset="0" Color="#009DAFC4"/><GradientStop Offset="0.003" Color="#9DAFC4"/>
            <GradientStop Offset="0.097" Color="#AFBED0"/><GradientStop Offset="0.1" Color="#00AFBED0"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Activity" Property="Visibility" Value="Visible"/><Trigger.EnterActions><BeginStoryboard x:Name="ActivityMotion"><Storyboard><DoubleAnimation Storyboard.TargetName="ActivityOffset" Storyboard.TargetProperty="X" From="-0.12" To="1.02" Duration="0:0:1.6" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><StopStoryboard BeginStoryboardName="ActivityMotion"/></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="#AEB8C4"/><Setter Property="Padding" Value="4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
      <StackPanel>
        <ToggleButton x:Name="HeaderSwitch" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch"
                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="HeaderSurface" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="5,4">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="Chevron" Width="12" Height="12" Data="M3.5,1.7 L7.1,5.1 Q8.1,6 7.1,6.9 L3.5,10.3"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Margin="3,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#2B3A4C"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="#9DAFC4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}" ContentSource="Content"/>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KitRollbackItem" TargetType="ListBoxItem"><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectionSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="#3B5066"/><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#AFBED0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#AFBED0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="KitNavigation" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
      <Border x:Name="ShadowLayer" Style="{StaticResource KitButtonShadow}" CornerRadius="6"/>
      <Border x:Name="NavigationSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
        <Grid>
          <Border Width="3" Height="18" CornerRadius="1.5" Background="{TemplateBinding BorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
        </Grid>
      </Border>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="#AFBED0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
