@echo off
rem Codex Guard / GPT6.1 TERRA max
setlocal EnableExtensions
set "CODEX_GUARD_SOURCE_CMD=%~f0"
set "CODEX_KIT_REPOSITORY=BerryFuwawa/codex-init-kit"
set "CODEX_KIT_COMPONENT=guard"
set "CODEX_KIT_VERSION=5.2.3"
set "CODEX_GUARD_AUTO=0"
if /I "%~1"=="--auto" set "CODEX_GUARD_AUTO=1"
if /I "%~1"=="--check-update" (
    call :CHECK_GITHUB_UPDATE "manual"
    exit /b 0
)
if "%CODEX_GUARD_AUTO%"=="1" (
    call :CHECK_GITHUB_UPDATE "background"
) else (
    call :CHECK_GITHUB_UPDATE "auto"
    if errorlevel 20 if not errorlevel 21 exit /b 0
)

"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $raw=[IO.File]::ReadAllText($env:CODEX_GUARD_SOURCE_CMD,[Text.Encoding]::UTF8); $m='###CODEX_'+'GUARD_PS_B64###'; $e='###CODEX_'+'GUARD_PS_B64_END###'; $i=$raw.IndexOf($m); $j=$raw.IndexOf($e); if($i -lt 0 -or $j -lt ($i+$m.Length)){throw 'Embedded PowerShell payload markers missing or invalid.'}; $b64=$raw.Substring($i+$m.Length,$j-($i+$m.Length)) -replace '\s',''; $code=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b64)); $sb=[ScriptBlock]::Create($code); if($env:CODEX_GUARD_AUTO -eq '1'){& $sb -Auto}else{& $sb}"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo Codex Guard exited with code %RC%.
  pause
)
endlocal & exit /b %RC%
::KIT_UPDATE_WRAPPER_BEGIN
:CHECK_GITHUB_UPDATE
setlocal DisableDelayedExpansion
set "CODEX_KIT_SELF=%~f0"
set "CODEX_KIT_UPDATE_MODE=%~1"
rem Parse this entire block before replacing the running CMD file.
(
    chcp 65001 >nul
    powershell.exe -NoLogo -NoProfile -InputFormat Text -OutputFormat Text -ExecutionPolicy Bypass -EncodedCommand 
    if errorlevel 20 if not errorlevel 21 (
        chcp 936 >nul
        endlocal & exit /b 20
    )
    chcp 936 >nul
    endlocal & exit /b 0
)
::KIT_UPDATE_WRAPPER_END
